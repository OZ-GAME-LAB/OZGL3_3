    "DialogueText": "돌아왔구나. 다친 곳은 없어?",
    "NextDialogueId": "MS_RIA_CH1_REPORT_002",
    "RewardItemId": null,
    "RewardAmount": 0,
    "NotificationId": null,
    "TriggerId": null
  },
  {
